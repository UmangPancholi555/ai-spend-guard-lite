# Path is relative to prisma/schema.prisma
DATABASE_URL="file:./spendguard.db"
PORT=4000
# Directory for persistent JSONL logs
LOG_DIR="./data/logs"

# --- Authentication -------------------------------------------------------
# Login is ON by default. AUTH_ENABLED=false disables it entirely (local dev/tests only; the server prints a loud warning).
AUTH_ENABLED=true
# Absolute session lifetime in hours (sessions also expire after 30 minutes of inactivity)
SESSION_TTL_HOURS=12
# Set to true when the app is served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Optional: create the first admin at startup when no users exist (placeholders - choose your own, 12+ characters).
# Alternatively open the app and use the /setup page, or run: USERNAME=alice PASSWORD='...' npm run user:create
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: failed login attempts allowed per IP per minute (default 10)
# AUTH_LOGIN_IP_LIMIT_PER_MINUTE=10
